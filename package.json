{
  "name": "ninja-proxmox",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted control plane for a Proxmox VE cluster: a safe HTTP API and operator web UI over the PVE API",
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "key:create": "tsx src/cli/create-key.ts",
    "pve:check": "tsx src/cli/check-pve.ts",
    "docs:spec": "tsx src/cli/write-spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/websocket": "^11.3.0",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@sinclair/typebox": "^0.34.52",
    "bullmq": "^6.3.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
