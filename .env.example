# ─── Proxmox ─────────────────────────────────────────────────────────────────
# Preferred entry node. Node-agnostic calls go here; if it is unreachable we
# fall back to any node the poller last saw online.
PVE_HOST=pve-1.lan:8006
# A privilege-separated token, not root@pam. See README "Setting up the
# Proxmox side" — a token with --privsep 1 has no permissions until granted.
PVE_TOKEN_ID=ninja@pve!ctl
PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# ca | verify | pin | insecure.
# `ca` is the default and the right answer for a cluster: Proxmox signs every
# node's certificate with one cluster CA, so a single trust anchor covers all
# of them, including nodes added later. A pinned leaf fingerprint covers
# exactly one node. `insecure` refuses to start when NODE_ENV=production.
PVE_TLS_MODE=ca
# Required for `ca`. A copy of /etc/pve/pve-root-ca.pem from any node; the
# provisioner installs it for you.
PVE_CA_FILE=/etc/ninja-proxmox/pve-root-ca.pem
# Required for `pin`. `npm run pve:check` prints the current host's value.
PVE_TLS_FINGERPRINT=

# The Proxmox node this service is itself running on, if it runs on one at all.
# Node power actions against it are refused: rebooting your own host mid-request
# cannot report how it went. Blank when deployed off-cluster.
PVE_SELF_NODE=
ALLOW_SELF_NODE_POWER=false

# ─── Service ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info

# ─── Backing services ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://ninja:ninja@localhost:5432/ninjaproxmox

# ─── Upstream concurrency ────────────────────────────────────────────────────
# The scarce upstream resource is pvedaemon worker slots, not requests per
# second — it forks three workers by default. These are budgets, not rate
# limits, and the per-node cap deliberately leaves headroom for the cluster's
# own web UI.
PVE_MAX_INFLIGHT=6
PVE_MAX_INFLIGHT_PER_NODE=2
# Share of the global budget background work may hold, so a backup sweep can
# never starve a user who is waiting on a button.
PVE_BULK_CEILING=0.66
# Past this, queued calls fail fast with `pve_busy` instead of piling up.
PVE_QUEUE_WAIT_MS=5000
PVE_CONNECTIONS_PER_NODE=4

# ─── Polling and tasks ───────────────────────────────────────────────────────
# One /cluster/resources call per tick serves every viewer, so this cadence is
# independent of how many people have the UI open.
POLL_RESOURCES_S=5
# Follower backoff bounds. qmstart finishes in a second; vzdump runs for an
# hour. Polling both at the floor would spend the whole concurrency budget.
TASK_POLL_MIN_MS=500
TASK_POLL_MAX_MS=10000
TASK_LOG_TAIL_LINES=200
# How long to hunt the node task list for a worker whose POST timed out before
# giving up and marking the task `unknown`. We never retry the write.
PVE_RECONCILE_WINDOW_S=60
# Replay window for the Idempotency-Key header.
IDEMPOTENCY_TTL_S=86400

# ─── Safety ──────────────────────────────────────────────────────────────────
# Guests carrying these tags, or these vmids, can never be deleted through this
# service regardless of scope. Proxmox's own `protection` flag is honoured too.
PROTECTED_TAGS=prod
PROTECTED_VMIDS=
# `purge` will not remove backup archives unless this is false.
RETAIN_BACKUPS_ON_DELETE=true
# Config keys a PUT may touch. `args` and `hookscript` are arbitrary code
# execution on the host and are never allow-listed.
CONFIG_ALLOWED_KEYS=name,description,tags,onboot,cores,sockets,memory,balloon,startup
# A bulk action resolves to at most this many guests, and must echo the
# selector hash from a dry run.
BULK_MAX_TARGETS=25
BULK_CONCURRENCY=2
STORAGE_WARN_FREE_PCT=10

# ─── Auth ────────────────────────────────────────────────────────────────────
# Runs every request as a synthetic dev-local consumer with all scopes. Refuses
# to start with NODE_ENV=production; the test suite pins it off.
AUTH_DISABLED=false
ADMIN_IP_ALLOWLIST=

# ─── Console (opt-in) ────────────────────────────────────────────────────────
# Off by default and deliberately separate: Proxmox API tokens cannot
# authenticate the /vncwebsocket upgrade, so console needs a real user's
# ticket. If you would rather not store a password, leave this off — the UI
# links to the Proxmox console instead, which is a supported configuration.
CONSOLE_ENABLED=false
CONSOLE_PVE_USER=ninja-console@pve
CONSOLE_PVE_PASSWORD=
CONSOLE_SESSION_TTL_S=120

# ─── Retention ───────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
EVENT_RETENTION_DAYS=30
METRICS_INTERVAL_S=15

# ─── UI ──────────────────────────────────────────────────────────────────────
DOCS_UI=true
WEB_UI=true
